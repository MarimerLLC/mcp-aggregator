<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="McpAggregator.Core.Tests" />
    <InternalsVisibleTo Include="McpAggregator.Measure" />
  </ItemGroup>

  <ItemGroup>
    <!-- The aggregator's own skill document, shipped so a release can update the live copy (issue #72). -->
    <EmbeddedResource Include="..\..\data\skills\mcp-aggregator.md"
                      LogicalName="McpAggregator.Core.Skills.mcp-aggregator.md"
                      Link="Skills\mcp-aggregator.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.*" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />
  </ItemGroup>

</Project>
